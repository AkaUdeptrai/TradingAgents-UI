# Local backend binding; in Docker the process uses 0.0.0.0:8000 internally.
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8000
# Public API base path, compiled into the frontend. Vite proxies /api locally.
PORTAL_API_URL=/api
# Same-origin mode needs no CORS. For separate origins use an explicit list:
# PORTAL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORTAL_CORS_ORIGINS=
# Optional built frontend directory for Python-only serving (Docker sets this).
# PORTAL_STATIC_DIR=/absolute/path/to/portal/frontend/dist
# Provider credentials/config continue to use the repository's .env mechanism.
# Google sign-in. Keep the email allowlist empty until you choose approved users.
PORTAL_GOOGLE_CLIENT_ID=
PORTAL_GOOGLE_CLIENT_SECRET=
PORTAL_ALLOWED_EMAILS=
# Exact approved administrator emails; each must also appear in PORTAL_ALLOWED_EMAILS.
PORTAL_ADMIN_EMAILS=
# Browser origin, no path. Empty uses http://127.0.0.1:8000 in Docker/backend,
# or http://127.0.0.1:5173 with dev-portal.sh. Use HTTPS outside loopback.
PORTAL_PUBLIC_URL=
# Google authorized redirect URI: <PORTAL_PUBLIC_URL>/api/auth/google/callback
PORTAL_SESSION_TTL_SECONDS=28800
# Default: ~/.tradingagents/portal/auth.sqlite3; Docker uses a separate named volume.
# PORTAL_AUTH_DB=/absolute/path/auth.sqlite3
