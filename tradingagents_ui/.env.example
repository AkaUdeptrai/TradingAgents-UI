# Local application binding; Docker uses 0.0.0.0:8000 internally.
TRADINGAGENTS_UI_HOST=127.0.0.1
TRADINGAGENTS_UI_PORT=8000
# Public API base path, compiled into the frontend. Vite proxies /api locally.
TRADINGAGENTS_UI_API_URL=/api
# Same-origin mode needs no CORS. For separate origins use an explicit list:
# TRADINGAGENTS_UI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRADINGAGENTS_UI_CORS_ORIGINS=
# Optional built frontend directory for Python-only serving (Docker sets this).
# TRADINGAGENTS_UI_STATIC_DIR=/absolute/path/to/tradingagents_ui/web/dist
# Provider credentials/config continue to use the repository's .env mechanism.
# Google sign-in. Keep the email allowlist empty until you choose approved users.
TRADINGAGENTS_UI_GOOGLE_CLIENT_ID=
TRADINGAGENTS_UI_GOOGLE_CLIENT_SECRET=
TRADINGAGENTS_UI_ALLOWED_EMAILS=
# Exact approved administrator emails; each must also appear in TRADINGAGENTS_UI_ALLOWED_EMAILS.
TRADINGAGENTS_UI_ADMIN_EMAILS=
# Browser origin, no path. Empty uses http://127.0.0.1:8000 in Docker,
# or http://127.0.0.1:5173 with dev-tradingagents-ui.sh. Use HTTPS outside loopback.
TRADINGAGENTS_UI_PUBLIC_URL=
# Google authorized redirect URI: <TRADINGAGENTS_UI_PUBLIC_URL>/api/auth/google/callback
TRADINGAGENTS_UI_SESSION_TTL_SECONDS=28800
# Default: ~/.tradingagents/portal/auth.sqlite3; Docker uses a separate named volume.
# TRADINGAGENTS_UI_AUTH_DB=/absolute/path/auth.sqlite3
