{
  "components": {
    "schemas": {
      "AuthStatus": {
        "properties": {
          "configured": {
            "title": "Configured",
            "type": "boolean"
          },
          "provider": {
            "const": "google",
            "default": "google",
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "configured"
        ],
        "title": "AuthStatus",
        "type": "object"
      },
      "CapabilitiesResponse": {
        "properties": {
          "analysts": {
            "items": {
              "$ref": "#/components/schemas/Option"
            },
            "title": "Analysts",
            "type": "array"
          },
          "configurable_settings": {
            "items": {
              "$ref": "#/components/schemas/SettingDescriptor"
            },
            "title": "Configurable Settings",
            "type": "array"
          },
          "output_languages": {
            "$ref": "#/components/schemas/LanguageCapability"
          },
          "providers": {
            "items": {
              "$ref": "#/components/schemas/Provider"
            },
            "title": "Providers",
            "type": "array"
          },
          "runtime": {
            "$ref": "#/components/schemas/RuntimeCapabilities"
          }
        },
        "required": [
          "providers",
          "analysts",
          "configurable_settings",
          "output_languages",
          "runtime"
        ],
        "title": "CapabilitiesResponse",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "application": {
            "const": "available",
            "title": "Application",
            "type": "string"
          },
          "core": {
            "enum": [
              "available",
              "unavailable"
            ],
            "title": "Core",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "application",
          "core"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "JsonValue": {},
      "LanguageCapability": {
        "properties": {
          "description": {
            "default": "Core nh\u1eadn t\u00ean ng\u00f4n ng\u1eef d\u1ea1ng v\u0103n b\u1ea3n; danh s\u00e1ch g\u1ee3i \u00fd kh\u00f4ng \u0111\u1ea7y \u0111\u1ee7.",
            "title": "Description",
            "type": "string"
          },
          "mode": {
            "const": "free_text",
            "default": "free_text",
            "title": "Mode",
            "type": "string"
          },
          "suggestions": {
            "items": {
              "type": "string"
            },
            "title": "Suggestions",
            "type": "array"
          }
        },
        "required": [
          "suggestions"
        ],
        "title": "LanguageCapability",
        "type": "object"
      },
      "Option": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label"
        ],
        "title": "Option",
        "type": "object"
      },
      "Provider": {
        "properties": {
          "allows_custom_model": {
            "title": "Allows Custom Model",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "models": {
            "additionalProperties": {
              "items": {
                "$ref": "#/components/schemas/Option"
              },
              "type": "array"
            },
            "title": "Models",
            "type": "object"
          }
        },
        "required": [
          "id",
          "models",
          "allows_custom_model"
        ],
        "title": "Provider",
        "type": "object"
      },
      "RuntimeCapabilities": {
        "properties": {
          "analysis_execution": {
            "const": false,
            "default": false,
            "title": "Analysis Execution",
            "type": "boolean"
          },
          "history": {
            "const": false,
            "default": false,
            "title": "History",
            "type": "boolean"
          },
          "settings_write": {
            "const": false,
            "default": false,
            "title": "Settings Write",
            "type": "boolean"
          }
        },
        "title": "RuntimeCapabilities",
        "type": "object"
      },
      "SettingDescriptor": {
        "properties": {
          "key": {
            "title": "Key",
            "type": "string"
          },
          "read_only": {
            "const": true,
            "default": true,
            "title": "Read Only",
            "type": "boolean"
          },
          "value_type": {
            "title": "Value Type",
            "type": "string"
          }
        },
        "required": [
          "key",
          "value_type"
        ],
        "title": "SettingDescriptor",
        "type": "object"
      },
      "SettingsResponse": {
        "properties": {
          "read_only": {
            "const": true,
            "default": true,
            "title": "Read Only",
            "type": "boolean"
          },
          "source": {
            "const": "core_defaults_and_environment",
            "default": "core_defaults_and_environment",
            "title": "Source",
            "type": "string"
          },
          "values": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Values",
            "type": "object"
          }
        },
        "required": [
          "values"
        ],
        "title": "SettingsResponse",
        "type": "object"
      },
      "UserIdentity": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "default": "user",
            "enum": [
              "user",
              "admin"
            ],
            "title": "Role",
            "type": "string"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "subject",
          "email",
          "name"
        ],
        "title": "UserIdentity",
        "type": "object"
      },
      "VersionResponse": {
        "properties": {
          "core": {
            "title": "Core",
            "type": "string"
          },
          "ui": {
            "title": "Ui",
            "type": "string"
          }
        },
        "required": [
          "ui",
          "core"
        ],
        "title": "VersionResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyCookie": {
        "in": "cookie",
        "name": "portal_session",
        "type": "apiKey"
      }
    }
  },
